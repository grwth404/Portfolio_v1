---
interface Props {
	eyebrow: string;
	title: string;
	description: string;
	revealClass?: string;
	delay?: string;
}

const { eyebrow, title, description, revealClass, delay = "0ms" } = Astro.props;
---

<div
	class:list={["text-center max-w-3xl mx-auto", revealClass]}
	style={`--d: ${delay}`}
>
	<div class="flex items-center justify-center gap-3 mb-6">
		<span class="h-1.5 w-1.5 rotate-45 bg-accent"></span>
		<span class="text-[0.8rem] uppercase tracking-[0.35em] text-accent">
			{eyebrow}
		</span>
		<span class="h-1.5 w-1.5 rotate-45 bg-accent"></span>
	</div>
	<h2
		class="font-sans font-extralight text-3xl sm:text-4xl lg:text-5xl tracking-tighter uppercase text-text leading-tight"
	>
		{title}
	</h2>
	<p
		class="mt-5 sm:text-xs text-text/80 uppercase tracking-wider leading-relaxed max-w-2xl mx-auto"
	>
		<slot name="description">{description}</slot>
	</p>
</div>
