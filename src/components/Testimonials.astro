---
import { testimonials } from "../data/testimonials";
import { sections } from "../data/sections";
import SectionHeader from "./ui/SectionHeader.astro";

const { testimonials: section } = sections;
const total = testimonials.length;
---

<section id="testimonials" class="mt-24">
	<SectionHeader
		eyebrow={section.eyebrow}
		title={section.title}
		description={section.description}
		revealClass="testimonials-reveal"
	/>

	<div
		class="testimonials-reveal testimonials-panel relative mt-12 overflow-visible border border-text/15 bg-bg"
		style="--d: 100ms"
	>
		<span
			class="pointer-events-none absolute -top-px -left-px z-20 h-5 w-5 border-t-2 border-l-2 border-accent-bright"
			aria-hidden="true"></span>
		<span
			class="pointer-events-none absolute -top-px -right-px z-20 h-5 w-5 border-t-2 border-r-2 border-accent-bright"
			aria-hidden="true"></span>
		<span
			class="pointer-events-none absolute -bottom-px -left-px z-20 h-5 w-5 border-b-2 border-l-2 border-accent-bright"
			aria-hidden="true"></span>
		<span
			class="pointer-events-none absolute -right-px -bottom-px z-20 h-5 w-5 border-b-2 border-r-2 border-accent-bright"
			aria-hidden="true"></span>

		<div class="relative border-b border-text/10 px-4 py-3 sm:px-5">
			<div class="flex items-center justify-between gap-3">
				<div class="flex items-center gap-2.5">
					<span class="h-2 w-2 shrink-0 bg-accent-bright" aria-hidden="true"
					></span>
					<span class="font-mono text-sm tracking-tight text-text"
						>testimonials.db</span
					>
				</div>
				<p class="text-right text-[0.7rem] tabular-nums tracking-wide text-text/70">
					{total} / {total} shown
				</p>
			</div>
		</div>

		<div class="testimonials-stage px-4 py-5 sm:px-5">
			<div class="overflow-hidden" id="testimonial-viewport">
				<div
					id="testimonial-track"
					class="flex gap-4 transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform"
					data-count={total}
				>
					{
						testimonials.map((item, index) => (
							<article class="testimonial-slide shrink-0" data-index={index}>
								<div class="testimonial-card">
									<div class="testimonial-meta">
										<span class="testimonial-index">
											{String(index + 1).padStart(2, "0")}
										</span>
										<div
											class="testimonial-stars"
											role="img"
											aria-label={`${item.rating} out of 5 stars`}
										>
											{Array.from({ length: item.rating }).map(() => (
												<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
													<path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01L12 2z" />
												</svg>
											))}
										</div>
									</div>

									<blockquote class="testimonial-quote">"{item.quote}"</blockquote>

									<div class="testimonial-person">
										<img
											src={item.avatar}
											alt=""
											width="40"
											height="40"
											class="testimonial-avatar"
											loading="lazy"
										/>
										<div class="min-w-0">
											<p class="testimonial-name">{item.name}</p>
											<p class="testimonial-role">{item.role}</p>
										</div>
									</div>
								</div>
							</article>
						))
					}
				</div>
			</div>
		</div>

		<div
			class="flex flex-wrap items-center justify-between gap-3 border-t border-text/10 px-4 py-3.5 sm:px-5"
		>
			<p id="testimonial-range" class="testimonial-range" aria-live="polite">
				Showing 1–{Math.min(3, total)} of {total}
			</p>
			<div class="flex items-center gap-2">
				<button
					type="button"
					id="testimonial-prev"
					class="testimonial-nav"
					aria-label="Previous testimonials"
				>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
						<path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"
						></path>
					</svg>
				</button>
				<div id="testimonial-dots" class="flex items-center gap-1.5"></div>
				<button
					type="button"
					id="testimonial-next"
					class="testimonial-nav"
					aria-label="Next testimonials"
				>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
						></path>
					</svg>
				</button>
			</div>
		</div>
	</div>
</section>

<script>
	import { onDomReady } from "../lib/dom";
	import { observeSectionReveal } from "../lib/reveal";

	function initTestimonials() {
		const section = document.getElementById("testimonials");
		const track = document.getElementById("testimonial-track");
		const viewport = document.getElementById("testimonial-viewport");
		const prevBtn = document.getElementById("testimonial-prev");
		const nextBtn = document.getElementById("testimonial-next");
		const dotsEl = document.getElementById("testimonial-dots");
		const rangeEl = document.getElementById("testimonial-range");

		if (
			!section ||
			!track ||
			!viewport ||
			!(prevBtn instanceof HTMLButtonElement) ||
			!(nextBtn instanceof HTMLButtonElement) ||
			!dotsEl
		) {
			return;
		}

		const slides = Array.from(
			track.querySelectorAll<HTMLElement>(".testimonial-slide"),
		);
		const total = slides.length;
		let current = 0;
		let perView = 3;
		let maxIndex = 0;
		let autoplayTimer = 0;
		const GAP = 16;

		const getPerView = () => {
			if (window.innerWidth >= 1024) return 3;
			if (window.innerWidth >= 640) return 2;
			return 1;
		};

		const buildDots = () => {
			dotsEl.innerHTML = "";
			for (let i = 0; i <= maxIndex; i++) {
				const dot = document.createElement("button");
				dot.type = "button";
				dot.className = "testimonial-dot";
				dot.setAttribute("aria-label", `Go to slide ${i + 1}`);
				dot.addEventListener("click", () => goTo(i));
				dotsEl.appendChild(dot);
			}
		};

		const updateDots = () => {
			dotsEl
				.querySelectorAll<HTMLButtonElement>(".testimonial-dot")
				.forEach((dot, i) => {
					dot.classList.toggle("is-active", i === current);
				});
		};

		const updateRange = () => {
			if (!rangeEl || total === 0) return;
			const from = current + 1;
			const to = Math.min(current + perView, total);
			rangeEl.textContent = `Showing ${from}–${to} of ${total}`;
		};

		const layout = () => {
			perView = getPerView();
			maxIndex = Math.max(total - perView, 0);
			if (current > maxIndex) current = maxIndex;

			const viewportW = viewport.clientWidth;
			const slideWidth = Math.floor(
				(viewportW - GAP * (perView - 1)) / perView,
			);
			slides.forEach((slide) => {
				slide.style.width = `${slideWidth}px`;
			});

			buildDots();
			updateDots();
			applyTransform(false);
			prevBtn.disabled = current === 0;
			nextBtn.disabled = current >= maxIndex;
		};

		const applyTransform = (animate = true) => {
			const viewportW = viewport.clientWidth;
			const slideWidth = Math.floor(
				(viewportW - GAP * (perView - 1)) / perView,
			);
			const offset = current * (slideWidth + GAP);
			track.style.transitionDuration = animate ? "700ms" : "0ms";
			track.style.transform = `translateX(-${offset}px)`;

			slides.forEach((slide, i) => {
				const visible = i >= current && i < current + perView;
				const card = slide.querySelector<HTMLElement>(".testimonial-card");
				if (!card || !visible || !animate) return;

				card.animate(
					[
						{ opacity: 0.6, transform: "translateY(12px) scale(0.98)" },
						{ opacity: 1, transform: "translateY(0) scale(1)" },
					],
					{
						duration: 500,
						delay: (i - current) * 80,
						easing: "cubic-bezier(0.22, 1, 0.36, 1)",
						fill: "both",
					},
				);
			});

			prevBtn.disabled = current === 0;
			nextBtn.disabled = current >= maxIndex;
			updateDots();
			updateRange();
		};

		const goTo = (index: number) => {
			current = Math.max(0, Math.min(index, maxIndex));
			applyTransform(true);
			resetAutoplay();
		};

		const next = () => {
			if (current < maxIndex) goTo(current + 1);
			else goTo(0);
		};

		const prev = () => {
			if (current > 0) goTo(current - 1);
			else goTo(maxIndex);
		};

		const resetAutoplay = () => {
			if (autoplayTimer) window.clearInterval(autoplayTimer);
			autoplayTimer = window.setInterval(next, 6000);
		};

		prevBtn.addEventListener("click", prev);
		nextBtn.addEventListener("click", next);

		let resizeTimer = 0;
		const onResize = () => {
			window.clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(layout, 50);
		};
		window.addEventListener("resize", onResize);
		const resizeObserver = new ResizeObserver(onResize);
		resizeObserver.observe(viewport);

		layout();
		resetAutoplay();

		section.addEventListener("mouseenter", () => {
			if (autoplayTimer) window.clearInterval(autoplayTimer);
		});
		section.addEventListener("mouseleave", resetAutoplay);

		observeSectionReveal("testimonials", ".testimonials-reveal", {
			threshold: 0.15,
			onReveal: () => {
				slides.slice(0, perView).forEach((slide, i) => {
					const card = slide.querySelector<HTMLElement>(".testimonial-card");
					if (!card) return;
					card.animate(
						[
							{ opacity: 0, transform: "translateY(28px) scale(0.96)" },
							{ opacity: 1, transform: "translateY(0) scale(1)" },
						],
						{
							duration: 650,
							delay: 200 + i * 100,
							easing: "cubic-bezier(0.22, 1, 0.36, 1)",
							fill: "both",
						},
					);
				});
			},
		});
	}

	onDomReady(initTestimonials);
</script>

<style>
	.testimonials-panel,
	.testimonial-card,
	.testimonial-avatar,
	.testimonial-nav,
	.testimonial-dot {
		border-radius: 0;
	}

	.testimonials-stage {
		background-image: radial-gradient(
			circle,
			color-mix(in srgb, var(--color-text) 16%, transparent) 1px,
			transparent 1px
		);
		background-size: 14px 14px;
	}

	.testimonial-slide {
		display: flex;
		min-width: 0;
	}

	.testimonial-card {
		position: relative;
		display: flex;
		width: 100%;
		height: 100%;
		flex-direction: column;
		border: 1px solid color-mix(in srgb, var(--color-text) 14%, transparent);
		background: var(--color-bg);
		padding: 1.05rem 1.1rem 0.95rem;
		transition:
			border-color 0.35s ease,
			background-color 0.35s ease;
	}

	.testimonial-card::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		z-index: 2;
		width: 0;
		height: 2px;
		background: var(--color-accent-bright);
		pointer-events: none;
		transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.testimonial-card:hover {
		border-color: var(--color-accent-bright);
		background: color-mix(in srgb, var(--color-accent-bright) 6%, var(--color-bg));
	}

	.testimonial-card:hover::before {
		width: 100%;
	}

	.testimonial-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.testimonial-index {
		font-size: 0.72rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.16em;
		color: var(--color-accent-bright);
	}

	.testimonial-stars {
		display: flex;
		gap: 0.12rem;
	}

	.testimonial-stars svg {
		width: 0.78rem;
		height: 0.78rem;
		color: var(--color-accent-bright);
	}

	.testimonial-quote {
		flex: 1;
		margin: 0.95rem 0 0;
		border-left: 2px solid var(--color-accent-bright);
		padding-left: 0.8rem;
		font-size: 0.92rem;
		font-weight: 400;
		line-height: 1.6;
		color: color-mix(in srgb, var(--color-text) 88%, transparent);
	}

	.testimonial-person {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-top: 1.15rem;
		border-top: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
		padding-top: 0.9rem;
	}

	.testimonial-avatar {
		width: 2.5rem;
		height: 2.5rem;
		flex-shrink: 0;
		object-fit: cover;
		border: 1px solid color-mix(in srgb, var(--color-text) 18%, transparent);
		background: #242938;
	}

	.testimonial-card:hover .testimonial-avatar {
		border-color: var(--color-accent-bright);
	}

	.testimonial-name {
		overflow: hidden;
		font-size: 0.92rem;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.02em;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: var(--color-text);
	}

	.testimonial-role {
		overflow: hidden;
		margin-top: 0.15rem;
		font-size: 0.72rem;
		line-height: 1.35;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: color-mix(in srgb, var(--color-text) 58%, transparent);
	}

	.testimonial-range {
		font-size: 0.78rem;
		color: color-mix(in srgb, var(--color-text) 55%, transparent);
	}

	.testimonial-nav {
		display: grid;
		width: 2rem;
		height: 2rem;
		place-items: center;
		border: 1px solid color-mix(in srgb, var(--color-text) 16%, transparent);
		background: transparent;
		color: color-mix(in srgb, var(--color-text) 72%, transparent);
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			color 0.2s ease,
			background-color 0.2s ease;
	}

	.testimonial-nav svg {
		width: 0.9rem;
		height: 0.9rem;
	}

	.testimonial-nav:hover:not(:disabled) {
		border-color: var(--color-accent-bright);
		color: var(--color-text);
	}

	.testimonial-nav:disabled {
		opacity: 0.35;
		cursor: default;
	}

	.testimonial-nav:focus-visible {
		outline: 1px solid var(--color-accent-bright);
		outline-offset: 2px;
	}

	:global(.testimonial-dot) {
		width: 0.4rem;
		height: 0.4rem;
		border: 0;
		background: color-mix(in srgb, var(--color-text) 28%, transparent);
		padding: 0;
		cursor: pointer;
		transition:
			width 0.3s ease,
			background-color 0.3s ease;
	}

	:global(.testimonial-dot.is-active) {
		width: 1.35rem;
		background: var(--color-accent-bright);
	}

	:global(.testimonial-dot:focus-visible) {
		outline: 1px solid var(--color-accent-bright);
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.testimonial-card,
		.testimonial-card::before,
		.testimonial-nav,
		:global(.testimonial-dot) {
			transition: none;
		}
	}
</style>
