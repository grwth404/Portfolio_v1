---
import worldMap from "../data/worldMapPaths.json";
import { site } from "../data/site";
import { contactLinks, formSubjects } from "../data/contact";
import { sections } from "../data/sections";
import SectionHeader from "./ui/SectionHeader.astro";
import CornerBrackets from "./ui/CornerBrackets.astro";
import Icon from "./ui/Icon.astro";

const { contact: section } = sections;
const { email: CONTACT_EMAIL } = site.contact;
const { paths, london, hubs } = worldMap;
---

<section id="get-in-touch" class="mt-24">
	<SectionHeader
		eyebrow={section.eyebrow}
		title={section.title}
		description={section.description}
		revealClass="contact-reveal"
	/>

	<div
		class="contact-reveal mt-12 grid grid-cols-1 lg:grid-cols-2 gap-4 lg:gap-5"
		style="--d: 120ms"
	>
		<!-- Left: contact form -->
		<div
			class="relative rounded-xl border border-text/10 bg-text/2 overflow-hidden"
		>
			<CornerBrackets size="md" opacityClass="border-accent/60" />

			<div
				class="flex items-center justify-between px-5 py-3 border-b border-text/10 bg-bg/60"
			>
				<div class="flex items-center gap-2">
					<Icon icon="solar:lock-keyhole-linear" class="h-3.5 w-3.5" />
					<span class="text-[0.6rem] uppercase tracking-widest text-text/80">
						Secure Channel // Ready
					</span>
				</div>
				<span
					class="text-[0.55rem] uppercase tracking-wider text-accent/70 border border-accent/30 rounded px-2 py-0.5"
				>
					[ Encrypted ]
				</span>
			</div>

			<div class="px-5 py-4 border-b border-text/10 bg-bg/40">
				<p class="text-[0.55rem] uppercase tracking-widest text-text/60 mb-3">
					// Contact_Nodes
				</p>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
					{
						contactLinks.map((node) => (
							<a
								href={node.href}
								target={node.external ? "_blank" : undefined}
								rel={node.external ? "noopener noreferrer" : undefined}
								class="group flex items-center gap-3 rounded-lg border border-text/10 bg-bg/50 px-3 py-2.5 transition-all duration-300 hover:border-accent/40 hover:bg-accent/5 cursor-pointer"
							>
								<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md border border-accent/25 bg-accent/10 transition-colors group-hover:bg-accent/20">
									<Icon
										icon={node.icon}
										size={22}
										class="h-[1.35rem] w-[1.35rem] object-contain"
									/>
								</span>
								<span class="min-w-0">
									<span class="block text-[0.6rem] uppercase tracking-wider text-text">
										{node.label}
									</span>
									<span class="block text-[0.55rem] text-text/75 truncate">
										{node.value}
									</span>
									<span class="block text-[0.5rem] uppercase tracking-wider text-text/50 mt-0.5">
										{node.note}
									</span>
								</span>
							</a>
						))
					}
				</div>
			</div>

			<form
				id="contact-form"
				data-endpoint={`https://formsubmit.co/ajax/${CONTACT_EMAIL}`}
				class="p-5 sm:p-6 space-y-4"
			>
				<input type="hidden" name="_captcha" value="false" />
				<input type="hidden" name="_template" value="table" />
				<input
					type="hidden"
					id="contact-mail-subject"
					name="_subject"
					value="New portfolio message"
				/>
				<input type="hidden" name="_replyto" id="contact-replyto" value="" />
				<input
					type="text"
					name="_honey"
					class="hidden"
					tabindex="-1"
					autocomplete="off"
				/>

				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					<div>
						<label
							for="contact-name"
							class="text-[0.55rem] uppercase tracking-widest text-text/60 mb-2 flex items-center gap-1.5"
						>
							<Icon
								icon="solar:user-linear"
								size={14}
								class="h-3.5 w-3.5 opacity-70"
							/>
							Name
						</label>
						<input
							id="contact-name"
							type="text"
							name="name"
							required
							autocomplete="name"
							placeholder="Your name"
							class="w-full bg-bg/80 border border-text/10 rounded-lg px-3 py-2.5 text-xs text-text placeholder:text-text/45 outline-none focus:border-accent/50 transition-colors"
						/>
					</div>
					<div>
						<label
							for="contact-email"
							class="text-[0.55rem] uppercase tracking-widest text-text/60 mb-2 flex items-center gap-1.5"
						>
							<Icon
								icon="solar:letter-linear"
								size={14}
								class="h-3.5 w-3.5 opacity-70"
							/>
							Email
						</label>
						<input
							id="contact-email"
							type="email"
							name="email"
							required
							autocomplete="email"
							placeholder="you@email.com"
							class="w-full bg-bg/80 border border-text/10 rounded-lg px-3 py-2.5 text-xs text-text placeholder:text-text/45 outline-none focus:border-accent/50 transition-colors"
						/>
					</div>
				</div>

				<div>
					<label
						for="contact-subject"
						class="text-[0.55rem] uppercase tracking-widest text-text/60 mb-2 flex items-center gap-1.5"
					>
						<Icon
							icon="solar:tag-linear"
							size={14}
							class="h-3.5 w-3.5 opacity-70"
						/>
						Subject
					</label>
					<div class="relative">
						<select
							id="contact-subject"
							name="subject"
							required
							class="w-full appearance-none bg-bg/80 border border-text/10 rounded-lg px-3 py-2.5 text-xs text-text outline-none focus:border-accent/50 transition-colors cursor-pointer"
						>
							<option value="" disabled selected>Select a subject</option>
							{
								formSubjects.map((subject) => (
									<option value={subject}>{subject}</option>
								))
							}
						</select>
						<Icon
							icon="solar:alt-arrow-down-linear"
							color="c8c4bc"
							size={14}
							class="absolute right-3 top-1/2 -translate-y-1/2 h-3.5 w-3.5 opacity-40 pointer-events-none"
						/>
					</div>
				</div>

				<div>
					<label
						for="contact-message"
						class="text-[0.55rem] uppercase tracking-widest text-text/60 mb-2 flex items-center gap-1.5"
					>
						<Icon
							icon="solar:chat-round-dots-linear"
							size={14}
							class="h-3.5 w-3.5 opacity-70"
						/>
						Message
					</label>
					<textarea
						id="contact-message"
						name="message"
						required
						rows="5"
						placeholder="Enter your transmission..."
						class="w-full resize-none bg-bg/80 border border-text/10 rounded-lg px-3 py-2.5 text-xs text-text placeholder:text-text/45 outline-none focus:border-accent/50 transition-colors"
					></textarea>
				</div>

				<button
					type="submit"
					id="contact-submit"
					class="contact-submit w-full flex items-center justify-center gap-2 bg-accent text-on-accent text-xs uppercase tracking-widest py-3.5 transition-all duration-300 hover:bg-accent/85 hover:shadow-accent-glow-strong cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
					style="clip-path: polygon(0 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%);"
				>
					<Icon icon="solar:plain-2-linear" size={18} class="h-4 w-4" />
					<span id="contact-submit-label">Send Transmission</span>
				</button>

				<p
					id="contact-status"
					role="status"
					aria-live="polite"
					class="hidden text-[0.6rem] uppercase tracking-wider text-center leading-relaxed"
				>
				</p>

				<p
					class="text-[0.5rem] uppercase tracking-wider text-text/50 text-center flex items-center justify-center gap-1.5"
				>
					<Icon
						icon="solar:shield-check-linear"
						size={14}
						class="h-3.5 w-3.5 opacity-50"
					/>
					Your data is encrypted end-to-end. No spam. No data sharing.
				</p>
			</form>

			<div
				class="contact-scan absolute inset-x-0 h-24 pointer-events-none opacity-[0.06] bg-linear-to-b from-transparent via-accent to-transparent"
				aria-hidden="true"
			>
			</div>
		</div>

		<!-- Right: world map & location -->
		<div
			class="relative rounded-xl border border-text/10 bg-text/2 overflow-hidden flex flex-col min-h-[480px]"
		>
			<CornerBrackets size="md" opacityClass="border-accent/60" />

			<div class="px-5 py-3 border-b border-text/10 bg-bg/60">
				<span class="text-[0.6rem] uppercase tracking-widest text-text/80">
					// Global_Reach
				</span>
			</div>

			<div
				class="relative flex-1 flex flex-col items-center justify-center p-4 min-h-[300px]"
			>
				<svg
					id="world-map"
					viewBox="0 0 1000 500"
					class="w-full h-auto max-h-[320px]"
					preserveAspectRatio="xMidYMid meet"
					role="img"
					aria-label="World map showing UK location and remote work across US, Canada and EU"
				>
					<defs>
						<pattern
							id="map-grid"
							width="20"
							height="20"
							patternUnits="userSpaceOnUse"
						>
							<path
								d="M 20 0 L 0 0 0 20"
								fill="none"
								stroke="var(--color-chart)"
								stroke-width="0.4"
								stroke-opacity="0.06"></path>
						</pattern>
						<radialGradient id="london-glow" cx="50%" cy="50%" r="50%">
							<stop offset="0%" stop-color="#8b3a2a" stop-opacity="0.35"></stop>
							<stop offset="100%" stop-color="#8b3a2a" stop-opacity="0"></stop>
						</radialGradient>
					</defs>

					<rect width="1000" height="500" fill="url(#map-grid)"></rect>

					<g
						stroke="var(--color-chart)"
						stroke-opacity="0.06"
						stroke-width="0.6"
					>
						<line x1="0" y1="125" x2="1000" y2="125"></line>
						<line x1="0" y1="250" x2="1000" y2="250"></line>
						<line x1="0" y1="375" x2="1000" y2="375"></line>
						<line x1="250" y1="0" x2="250" y2="500"></line>
						<line x1="500" y1="0" x2="500" y2="500"></line>
						<line x1="750" y1="0" x2="750" y2="500"></line>
					</g>

					<path
						class="map-land-path"
						d={paths.land}
						fill="var(--color-chart)"
						fill-opacity="0.07"
						stroke="var(--color-chart)"
						stroke-opacity="0.18"
						stroke-width="0.6"></path>

					<path
						class="map-remote-region"
						data-region="us"
						d={paths.us}
						fill="#8b3a2a"
						fill-opacity="0.12"
						stroke="#8b3a2a"
						stroke-opacity="0.35"
						stroke-width="0.8"></path>
					<path
						class="map-remote-region"
						data-region="ca"
						d={paths.ca}
						fill="#8b3a2a"
						fill-opacity="0.12"
						stroke="#8b3a2a"
						stroke-opacity="0.35"
						stroke-width="0.8"></path>
					{
						paths.eu.map((d) => (
							<path
								class="map-remote-region map-eu-region"
								d={d}
								fill="#8b3a2a"
								fill-opacity="0.1"
								stroke="#8b3a2a"
								stroke-opacity="0.28"
								stroke-width="0.6"
							/>
						))
					}

					<path
						class="map-uk-region"
						d={paths.uk}
						fill="#8b3a2a"
						fill-opacity="0.22"
						stroke="#8b3a2a"
						stroke-opacity="0.65"
						stroke-width="1"></path>

					<g
						id="map-connections"
						fill="none"
						stroke="#8b3a2a"
						stroke-width="1.2"
					>
						{
							hubs.map((hub, i) => {
								const midX = (london.x + hub.x) / 2;
								const midY = (london.y + hub.y) / 2 - 40 - i * 12;
								return (
									<path
										class="map-connection"
										data-index={i}
										d={`M ${london.x} ${london.y} Q ${midX} ${midY} ${hub.x} ${hub.y}`}
										stroke-opacity="0.45"
										stroke-dasharray="6 5"
									/>
								);
							})
						}
					</g>

					{
						hubs.map((hub) => (
							<g class="map-hub">
								<circle
									cx={hub.x}
									cy={hub.y}
									r="4"
									fill="var(--color-chart)"
									fill-opacity="0.85"
								/>
								<text
									x={hub.x}
									y={hub.y - 12}
									text-anchor="middle"
									fill="var(--color-chart)"
									fill-opacity="0.7"
									font-size="12"
									font-family="Inter, ui-sans-serif, sans-serif"
									font-weight="500"
								>
									{hub.region}
								</text>
							</g>
						))
					}

					<g id="london-marker">
						<circle
							id="london-pulse-outer"
							cx={london.x}
							cy={london.y}
							r="16"
							fill="url(#london-glow)"></circle>
						<circle
							id="london-pulse"
							cx={london.x}
							cy={london.y}
							r="8"
							fill="#8b3a2a"
							fill-opacity="0.2"
							stroke="#8b3a2a"
							stroke-opacity="0.5"></circle>
						<circle cx={london.x} cy={london.y} r="4.5" fill="#8b3a2a"></circle>
						<text
							x={london.x}
							y={london.y - 16}
							text-anchor="middle"
							fill="var(--color-chart)"
							font-size="13"
							font-family="Inter, ui-sans-serif, sans-serif"
							font-weight="500"
						>
							LONDON
						</text>
					</g>
				</svg>

				<div
					class="mt-3 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[0.625rem] uppercase tracking-widest text-text/70"
				>
					<span class="flex items-center gap-1.5">
						<span class="h-2 w-2 rounded-full bg-accent"></span>
						London, UK
					</span>
					<span class="flex items-center gap-1.5">
						<span
							class="h-2 w-3 rounded-sm bg-accent/30 border border-accent/50"
						></span>
						United Kingdom
					</span>
					<span class="flex items-center gap-1.5">
						<span
							class="h-2 w-4 rounded-sm bg-accent/20 border border-accent/35"
						></span>
						Remote — US · CA · EU
					</span>
				</div>
			</div>

			<div class="px-5 pb-5 space-y-4">
				<div
					class="flex items-center justify-between rounded-lg border border-text/10 bg-bg/50 px-4 py-3"
				>
					<div>
						<p class="text-[0.55rem] uppercase tracking-widest text-text/60">
							Current Node
						</p>
						<p
							class="mt-1 font-sans text-sm uppercase tracking-wider text-text"
						>
							London, UK
						</p>
						<p class="text-[0.5rem] uppercase tracking-wider text-text/55">
							51.5074° N · 0.1278° W · GMT/BST
						</p>
					</div>
					<div class="relative h-14 w-14 shrink-0">
						<canvas id="radar-canvas" class="h-full w-full" aria-hidden="true"
						></canvas>
					</div>
				</div>

				<div class="border-t border-text/10 pt-4">
					<p class="text-[0.55rem] uppercase tracking-widest text-text/60 mb-2">
						// Status
					</p>
					<div class="flex items-center gap-2">
						<span class="relative flex h-2 w-2">
							<span
								class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"
							></span>
							<span class="relative inline-flex h-2 w-2 rounded-full bg-accent"
							></span>
						</span>
						<span class="text-[0.65rem] uppercase tracking-wider text-accent">
							Available For Hire
						</span>
					</div>
					<p
						class="mt-2 text-[0.55rem] uppercase tracking-wider text-text/65 leading-relaxed"
					>
						Open to Work —
						<span
							class="text-text bg-accent/20 border border-accent/30 rounded px-1.5 py-0.5"
						>
							US · CA · EU
						</span>
					</p>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import { onDomReady } from "../lib/dom";
	import { observeSectionReveal } from "../lib/reveal";

	function initWorldMap() {
		const map = document.getElementById("world-map");
		if (!map) return;

		const connections = map.querySelectorAll<SVGPathElement>(".map-connection");
		const remoteRegions = map.querySelectorAll<SVGElement>(
			".map-remote-region, .map-uk-region",
		);
		const landPath = map.querySelector<SVGPathElement>(".map-land-path");
		const londonPulse = map.querySelector("#london-pulse");
		const londonPulseOuter = map.querySelector("#london-pulse-outer");

		connections.forEach((path, i) => {
			const len = path.getTotalLength();
			path.style.strokeDasharray = `${len}`;
			path.style.strokeDashoffset = `${len}`;

			window.setTimeout(() => {
				path.animate([{ strokeDashoffset: len }, { strokeDashoffset: 0 }], {
					duration: 1400,
					delay: i * 200,
					easing: "cubic-bezier(0.22, 1, 0.36, 1)",
					fill: "forwards",
				});
			}, 400);
		});

		if (landPath) {
			landPath.animate([{ fillOpacity: 0.02 }, { fillOpacity: 0.09 }], {
				duration: 1200,
				easing: "ease-out",
				fill: "forwards",
			});
		}

		remoteRegions.forEach((region, i) => {
			const isUk = region.classList.contains("map-uk-region");
			region.animate(
				[
					{
						fillOpacity: isUk ? 0.12 : 0.05,
						strokeOpacity: isUk ? 0.35 : 0.15,
					},
					{
						fillOpacity: isUk ? 0.28 : 0.16,
						strokeOpacity: isUk ? 0.7 : 0.42,
					},
				],
				{
					duration: 2200,
					delay: 300 + i * 120,
					easing: "ease-in-out",
					direction: "alternate",
					iterations: Infinity,
				},
			);
		});

		if (londonPulse) {
			londonPulse.animate(
				[
					{ r: 7, fillOpacity: 0.15 },
					{ r: 11, fillOpacity: 0.35 },
				],
				{
					duration: 1800,
					easing: "ease-in-out",
					direction: "alternate",
					iterations: Infinity,
				},
			);
		}

		if (londonPulseOuter) {
			londonPulseOuter.animate(
				[
					{ r: 14, opacity: 0.5 },
					{ r: 20, opacity: 0.9 },
				],
				{
					duration: 2200,
					easing: "ease-in-out",
					direction: "alternate",
					iterations: Infinity,
				},
			);
		}
	}

	function initRadar() {
		const canvas = document.getElementById(
			"radar-canvas",
		) as HTMLCanvasElement | null;
		if (!canvas) return;

		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		const size = 56;
		canvas.width = size * dpr;
		canvas.height = size * dpr;
		canvas.style.width = `${size}px`;
		canvas.style.height = `${size}px`;
		ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

		let sweep = 0;
		let frameId = 0;

		const draw = () => {
			const cx = size / 2;
			const cy = size / 2;
			const r = size / 2 - 2;

			ctx.clearRect(0, 0, size, size);

			for (let i = 1; i <= 3; i++) {
				ctx.beginPath();
				ctx.arc(cx, cy, (r / 3) * i, 0, Math.PI * 2);
				ctx.strokeStyle = "rgba(200, 196, 188, 0.1)";
				ctx.stroke();
			}

			ctx.save();
			ctx.translate(cx, cy);
			ctx.rotate(sweep);
			const grad = ctx.createLinearGradient(0, 0, r, 0);
			grad.addColorStop(0, "rgba(139, 58, 42, 0)");
			grad.addColorStop(1, "rgba(139, 58, 42, 0.35)");
			ctx.fillStyle = grad;
			ctx.beginPath();
			ctx.moveTo(0, 0);
			ctx.arc(0, 0, r, -0.4, 0.4);
			ctx.closePath();
			ctx.fill();
			ctx.restore();

			ctx.beginPath();
			ctx.arc(cx, cy, 2, 0, Math.PI * 2);
			ctx.fillStyle = "#8b3a2a";
			ctx.fill();

			sweep += 0.04;
			frameId = requestAnimationFrame(draw);
		};

		frameId = requestAnimationFrame(draw);

		document.addEventListener(
			"astro:before-swap",
			() => cancelAnimationFrame(frameId),
			{ once: true },
		);
	}

	function initContactReveal() {
		const scan = document.querySelector<HTMLElement>(".contact-scan");
		if (scan) {
			scan.animate(
				[{ transform: "translateY(-100%)" }, { transform: "translateY(100%)" }],
				{ duration: 4000, iterations: Infinity, easing: "linear" },
			);
		}
		observeSectionReveal("get-in-touch", ".contact-reveal", {
			threshold: 0.12,
		});
	}

	function initContactForm() {
		const form = document.getElementById(
			"contact-form",
		) as HTMLFormElement | null;
		const submitBtn = document.getElementById(
			"contact-submit",
		) as HTMLButtonElement | null;
		const submitLabel = document.getElementById("contact-submit-label");
		const statusEl = document.getElementById("contact-status");
		const subjectSelect = document.getElementById(
			"contact-subject",
		) as HTMLSelectElement | null;
		const subjectHidden = document.getElementById(
			"contact-mail-subject",
		) as HTMLInputElement | null;
		const replyToHidden = document.getElementById(
			"contact-replyto",
		) as HTMLInputElement | null;
		const emailInput = document.getElementById(
			"contact-email",
		) as HTMLInputElement | null;

		if (!form || !submitBtn || !submitLabel || !statusEl) return;

		const endpoint = form.dataset.endpoint;
		if (!endpoint) return;

		const defaultLabel = submitLabel.textContent ?? "Send Transmission";

		const setStatus = (message: string, kind: "success" | "error" | "info") => {
			statusEl.textContent = message;
			statusEl.classList.remove(
				"hidden",
				"text-accent",
				"text-red-400",
				"text-text/70",
			);
			if (kind === "success") statusEl.classList.add("text-accent");
			else if (kind === "error") statusEl.classList.add("text-red-400");
			else statusEl.classList.add("text-text/70");
		};

		const setBusy = (busy: boolean) => {
			submitBtn.disabled = busy;
			submitLabel.textContent = busy ? "Transmitting..." : defaultLabel;
		};

		form.addEventListener("submit", async (event) => {
			event.preventDefault();

			const subject = subjectSelect?.value?.trim() || "New portfolio message";
			if (subjectHidden) {
				subjectHidden.value = `Portfolio — ${subject}`;
			}
			if (replyToHidden && emailInput) {
				replyToHidden.value = emailInput.value.trim();
			}

			setBusy(true);
			setStatus("Sending transmission...", "info");

			try {
				const response = await fetch(endpoint, {
					method: "POST",
					headers: {
						"Content-Type": "application/json",
						Accept: "application/json",
					},
					body: JSON.stringify(Object.fromEntries(new FormData(form))),
				});

				const result = (await response.json().catch(() => null)) as {
					success?: string | boolean;
					message?: string;
				} | null;

				if (!response.ok) {
					throw new Error(
						result?.message || "Transmission failed. Please try again.",
					);
				}

				form.reset();
				setStatus(
					"Transmission received. I'll get back to you soon.",
					"success",
				);
			} catch {
				setStatus(
					"Transmission failed. Please email me directly or try again.",
					"error",
				);
			} finally {
				setBusy(false);
			}
		});
	}

	function initContact() {
		initWorldMap();
		initRadar();
		initContactReveal();
		initContactForm();
	}

	onDomReady(initContact);
</script>
