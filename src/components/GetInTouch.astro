---
import worldMap from "../data/worldMapPaths.json";
import { site } from "../data/site";
import { contactLinks, formSubjects } from "../data/contact";
import { sections } from "../data/sections";
import SectionHeader from "./ui/SectionHeader.astro";
import Icon from "./ui/Icon.astro";

const { contact: section } = sections;
const { email: CONTACT_EMAIL } = site.contact;
const { paths, london, hubs } = worldMap;
---

<section id="get-in-touch" class="mt-24">
	<SectionHeader
		eyebrow={section.eyebrow}
		title={section.title}
		description={section.description}
		revealClass="contact-reveal"
	/>

	<div
		class="contact-reveal contact-panel relative mt-12 overflow-visible border border-text/15 bg-bg"
		style="--d: 120ms"
	>
		<span
			class="pointer-events-none absolute -top-px -left-px z-20 h-5 w-5 border-t-2 border-l-2 border-accent-bright"
			aria-hidden="true"></span>
		<span
			class="pointer-events-none absolute -top-px -right-px z-20 h-5 w-5 border-t-2 border-r-2 border-accent-bright"
			aria-hidden="true"></span>
		<span
			class="pointer-events-none absolute -bottom-px -left-px z-20 h-5 w-5 border-b-2 border-l-2 border-accent-bright"
			aria-hidden="true"></span>
		<span
			class="pointer-events-none absolute -right-px -bottom-px z-20 h-5 w-5 border-b-2 border-r-2 border-accent-bright"
			aria-hidden="true"></span>

		<div class="relative border-b border-text/10 px-4 py-3 sm:px-5">
			<div class="flex items-center justify-between gap-3">
				<div class="flex items-center gap-2.5">
					<span class="h-2 w-2 shrink-0 bg-accent-bright" aria-hidden="true"
					></span>
					<span class="font-mono text-sm tracking-tight text-text"
						>contact.open</span
					>
				</div>
				<span class="contact-badge">[ Encrypted ]</span>
			</div>
		</div>

		<div class="grid lg:grid-cols-2">
			<div
				class="flex flex-col gap-4 border-b border-text/10 px-4 py-5 sm:px-5 lg:border-r lg:border-b-0"
			>
				<fieldset class="contact-field">
					<legend class="contact-legend">// Contact_Nodes</legend>
					<div
						class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2"
					>
						{
							contactLinks.map((node) => (
								<a
									href={node.href}
									target={node.external ? "_blank" : undefined}
									rel={node.external ? "noopener noreferrer" : undefined}
									class="node-card"
									title={node.value}
								>
									<span class="node-mark" aria-hidden="true">
										<Icon
											icon={node.icon}
											color="f4f4f5"
											size={22}
											class="h-5 w-5 object-contain"
										/>
									</span>
									<span class="min-w-0">
										<span class="node-label">{node.label}</span>
										<span class="node-value">{node.value}</span>
										<span class="node-note">{node.note}</span>
									</span>
								</a>
							))
						}
					</div>
				</fieldset>

				<fieldset class="contact-field">
					<legend class="contact-legend">
						<i class="contact-legend-mark" aria-hidden="true"></i>
						Secure Channel // Ready
					</legend>

					<form
						id="contact-form"
						data-endpoint={`https://formsubmit.co/ajax/${CONTACT_EMAIL}`}
						class="space-y-4"
					>
						<input type="hidden" name="_captcha" value="false" />
						<input type="hidden" name="_template" value="table" />
						<input
							type="hidden"
							id="contact-mail-subject"
							name="_subject"
							value="New portfolio message"
						/>
						<input
							type="hidden"
							name="_replyto"
							id="contact-replyto"
							value=""
						/>
						<input
							type="text"
							name="_honey"
							class="hidden"
							tabindex="-1"
							autocomplete="off"
						/>

						<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
							<div>
								<label for="contact-name" class="contact-label">
									<Icon
										icon="solar:user-linear"
										color="c1502f"
										size={14}
										class="h-3.5 w-3.5"
									/>
									Name
								</label>
								<input
									id="contact-name"
									type="text"
									name="name"
									required
									autocomplete="name"
									placeholder="Your name"
									class="contact-input"
								/>
							</div>
							<div>
								<label for="contact-email" class="contact-label">
									<Icon
										icon="solar:letter-linear"
										color="c1502f"
										size={14}
										class="h-3.5 w-3.5"
									/>
									Email
								</label>
								<input
									id="contact-email"
									type="email"
									name="email"
									required
									autocomplete="email"
									placeholder="you@email.com"
									class="contact-input"
								/>
							</div>
						</div>

						<div>
							<label for="contact-subject" class="contact-label">
								<Icon
									icon="solar:tag-linear"
									color="c1502f"
									size={14}
									class="h-3.5 w-3.5"
								/>
								Subject
							</label>
							<select
								id="contact-subject"
								name="subject"
								required
								class="contact-input"
							>
								<option value="" disabled selected>Select a subject</option>
								{
									formSubjects.map((subject) => (
										<option value={subject}>{subject}</option>
									))
								}
							</select>
						</div>

						<div>
							<label for="contact-message" class="contact-label">
								<Icon
									icon="solar:chat-round-dots-linear"
									color="c1502f"
									size={14}
									class="h-3.5 w-3.5"
								/>
								Message
							</label>
							<textarea
								id="contact-message"
								name="message"
								required
								rows="5"
								placeholder="Enter your transmission..."
								class="contact-input"></textarea>
						</div>

						<button type="submit" id="contact-submit" class="contact-submit">
							<Icon
								icon="solar:plain-2-linear"
								color="f4f4f5"
								size={18}
								class="h-4 w-4"
							/>
							<span id="contact-submit-label">Send Transmission</span>
						</button>

						<p
							id="contact-status"
							role="status"
							aria-live="polite"
							class="contact-status hidden"
						>
						</p>

						<p class="contact-note">
							<Icon
								icon="solar:shield-check-linear"
								color="c1502f"
								size={14}
								class="h-3.5 w-3.5"
							/>
							Your data is encrypted end-to-end. No spam. No data sharing.
						</p>
					</form>
				</fieldset>
			</div>

			<div class="flex h-full flex-col gap-4 px-4 py-5 sm:px-5">
				<fieldset class="contact-field flex min-h-0 flex-1 flex-col">
					<legend class="contact-legend">// Global_Reach</legend>
					<div class="contact-map-stage">
						<svg
							id="world-map"
							viewBox="0 0 1000 500"
							preserveAspectRatio="xMidYMid meet"
							role="img"
							aria-label="World map showing UK location and remote work across US, Canada and EU"
						>
							<defs>
								<pattern
									id="map-grid"
									width="20"
									height="20"
									patternUnits="userSpaceOnUse"
								>
									<path
										d="M 20 0 L 0 0 0 20"
										fill="none"
										stroke="var(--color-chart)"
										stroke-width="0.4"
										stroke-opacity="0.08"></path>
								</pattern>
								<radialGradient id="london-glow" cx="50%" cy="50%" r="50%">
									<stop
										offset="0%"
										stop-color="var(--color-accent-bright)"
										stop-opacity="0.4"></stop>
									<stop
										offset="100%"
										stop-color="var(--color-accent-bright)"
										stop-opacity="0"></stop>
								</radialGradient>
							</defs>

							<rect width="1000" height="500" fill="url(#map-grid)"></rect>

							<g
								stroke="var(--color-chart)"
								stroke-opacity="0.08"
								stroke-width="0.6"
							>
								<line x1="0" y1="125" x2="1000" y2="125"></line>
								<line x1="0" y1="250" x2="1000" y2="250"></line>
								<line x1="0" y1="375" x2="1000" y2="375"></line>
								<line x1="250" y1="0" x2="250" y2="500"></line>
								<line x1="500" y1="0" x2="500" y2="500"></line>
								<line x1="750" y1="0" x2="750" y2="500"></line>
							</g>

							<path
								class="map-land-path"
								d={paths.land}
								fill="var(--color-chart)"
								fill-opacity="0.08"
								stroke="var(--color-chart)"
								stroke-opacity="0.22"
								stroke-width="0.6"></path>

							<path
								class="map-remote-region"
								data-region="us"
								d={paths.us}
								fill="var(--color-accent-bright)"
								fill-opacity="0.14"
								stroke="var(--color-accent-bright)"
								stroke-opacity="0.4"
								stroke-width="0.8"></path>
							<path
								class="map-remote-region"
								data-region="ca"
								d={paths.ca}
								fill="var(--color-accent-bright)"
								fill-opacity="0.14"
								stroke="var(--color-accent-bright)"
								stroke-opacity="0.4"
								stroke-width="0.8"></path>
							{
								paths.eu.map((d) => (
									<path
										class="map-remote-region map-eu-region"
										d={d}
										fill="var(--color-accent-bright)"
										fill-opacity="0.12"
										stroke="var(--color-accent-bright)"
										stroke-opacity="0.32"
										stroke-width="0.6"
									/>
								))
							}

							<path
								class="map-uk-region"
								d={paths.uk}
								fill="var(--color-accent-bright)"
								fill-opacity="0.28"
								stroke="var(--color-accent-bright)"
								stroke-opacity="0.75"
								stroke-width="1"></path>

							<g
								id="map-connections"
								fill="none"
								stroke="var(--color-accent-bright)"
								stroke-width="1.2"
							>
								{
									hubs.map((hub, i) => {
										const midX = (london.x + hub.x) / 2;
										const midY = (london.y + hub.y) / 2 - 40 - i * 12;
										return (
											<path
												class="map-connection"
												data-index={i}
												d={`M ${london.x} ${london.y} Q ${midX} ${midY} ${hub.x} ${hub.y}`}
												stroke-opacity="0.55"
												stroke-dasharray="6 5"
											/>
										);
									})
								}
							</g>

							{
								hubs.map((hub) => (
									<g class="map-hub">
										<circle
											cx={hub.x}
											cy={hub.y}
											r="4"
											fill="var(--color-chart)"
											fill-opacity="0.9"
										/>
										<text
											x={hub.x}
											y={hub.y - 12}
											text-anchor="middle"
											fill="var(--color-chart)"
											fill-opacity="0.75"
											font-size="12"
											font-family="Inter, ui-sans-serif, sans-serif"
											font-weight="500"
										>
											{hub.region}
										</text>
									</g>
								))
							}

							<g id="london-marker">
								<circle
									id="london-pulse-outer"
									cx={london.x}
									cy={london.y}
									r="16"
									fill="url(#london-glow)"></circle>
								<circle
									id="london-pulse"
									cx={london.x}
									cy={london.y}
									r="8"
									fill="var(--color-accent-bright)"
									fill-opacity="0.22"
									stroke="var(--color-accent-bright)"
									stroke-opacity="0.6"></circle>
								<circle
									cx={london.x}
									cy={london.y}
									r="4.5"
									fill="var(--color-accent-bright)"></circle>
								<text
									x={london.x}
									y={london.y - 16}
									text-anchor="middle"
									fill="var(--color-chart)"
									font-size="13"
									font-family="Inter, ui-sans-serif, sans-serif"
									font-weight="500"
								>
									LONDON
								</text>
							</g>
						</svg>

						<div class="contact-scan" aria-hidden="true"></div>
					</div>

					<div class="contact-key">
						<span>
							<i></i>
							London, UK
						</span>
						<span>
							<i class="is-uk"></i>
							United Kingdom
						</span>
						<span>
							<i class="is-remote"></i>
							Remote — US · CA · EU
						</span>
					</div>
				</fieldset>

				<div class="contact-node-box">
					<div class="min-w-0">
						<p class="contact-kicker">Current Node</p>
						<p class="contact-place">London, UK</p>
						<p class="contact-coords">51.5074° N · 0.1278° W · GMT/BST</p>
					</div>
					<div class="relative h-14 w-14 shrink-0">
						<canvas id="radar-canvas" class="h-full w-full" aria-hidden="true"
						></canvas>
					</div>
				</div>

				<div class="contact-status-block">
					<p class="contact-kicker">// Status</p>
					<div class="mt-2.5 flex items-center gap-2">
						<span class="contact-live" aria-hidden="true"></span>
						<span class="contact-hire">Available For Hire</span>
					</div>
					<p class="contact-open">
						Open to Work —
						<span class="contact-tag">US · CA · EU</span>
					</p>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import { onDomReady } from "../lib/dom";
	import { observeSectionReveal } from "../lib/reveal";

	function cssColor(name: string, fallback: string) {
		const value = getComputedStyle(document.documentElement)
			.getPropertyValue(name)
			.trim();
		return value || fallback;
	}

	function withAlpha(color: string, alpha: number) {
		const hex = color.startsWith("#") ? color.slice(1) : "";
		if (!/^[0-9a-fA-F]{6}$/.test(hex)) return color;
		const n = parseInt(hex, 16);
		const r = (n >> 16) & 255;
		const g = (n >> 8) & 255;
		const b = n & 255;
		return `rgba(${r}, ${g}, ${b}, ${alpha})`;
	}

	function initWorldMap() {
		const map = document.getElementById("world-map");
		if (!map) return;

		const connections = map.querySelectorAll<SVGPathElement>(".map-connection");
		const remoteRegions = map.querySelectorAll<SVGElement>(
			".map-remote-region, .map-uk-region",
		);
		const landPath = map.querySelector<SVGPathElement>(".map-land-path");
		const londonPulse = map.querySelector("#london-pulse");
		const londonPulseOuter = map.querySelector("#london-pulse-outer");

		connections.forEach((path, i) => {
			const len = path.getTotalLength();
			path.style.strokeDasharray = `${len}`;
			path.style.strokeDashoffset = `${len}`;

			window.setTimeout(() => {
				path.animate([{ strokeDashoffset: len }, { strokeDashoffset: 0 }], {
					duration: 1400,
					delay: i * 200,
					easing: "cubic-bezier(0.22, 1, 0.36, 1)",
					fill: "forwards",
				});
			}, 400);
		});

		if (landPath) {
			landPath.animate([{ fillOpacity: 0.02 }, { fillOpacity: 0.09 }], {
				duration: 1200,
				easing: "ease-out",
				fill: "forwards",
			});
		}

		remoteRegions.forEach((region, i) => {
			const isUk = region.classList.contains("map-uk-region");
			region.animate(
				[
					{
						fillOpacity: isUk ? 0.12 : 0.05,
						strokeOpacity: isUk ? 0.35 : 0.15,
					},
					{
						fillOpacity: isUk ? 0.28 : 0.16,
						strokeOpacity: isUk ? 0.7 : 0.42,
					},
				],
				{
					duration: 2200,
					delay: 300 + i * 120,
					easing: "ease-in-out",
					direction: "alternate",
					iterations: Infinity,
				},
			);
		});

		if (londonPulse) {
			londonPulse.animate(
				[
					{ r: 7, fillOpacity: 0.15 },
					{ r: 11, fillOpacity: 0.35 },
				],
				{
					duration: 1800,
					easing: "ease-in-out",
					direction: "alternate",
					iterations: Infinity,
				},
			);
		}

		if (londonPulseOuter) {
			londonPulseOuter.animate(
				[
					{ r: 14, opacity: 0.5 },
					{ r: 20, opacity: 0.9 },
				],
				{
					duration: 2200,
					easing: "ease-in-out",
					direction: "alternate",
					iterations: Infinity,
				},
			);
		}
	}

	function initRadar() {
		const canvas = document.getElementById(
			"radar-canvas",
		) as HTMLCanvasElement | null;
		if (!canvas) return;

		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		const accent = cssColor("--color-accent-bright", "#c1502f");
		const ink = cssColor("--color-text", "#f4f4f5");

		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		const size = 56;
		canvas.width = size * dpr;
		canvas.height = size * dpr;
		canvas.style.width = `${size}px`;
		canvas.style.height = `${size}px`;
		ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

		let sweep = 0;
		let frameId = 0;

		const draw = () => {
			const cx = size / 2;
			const cy = size / 2;
			const r = size / 2 - 2;

			ctx.clearRect(0, 0, size, size);

			for (let i = 1; i <= 3; i++) {
				ctx.beginPath();
				ctx.arc(cx, cy, (r / 3) * i, 0, Math.PI * 2);
				ctx.strokeStyle = withAlpha(ink, 0.16);
				ctx.stroke();
			}

			ctx.save();
			ctx.translate(cx, cy);
			ctx.rotate(sweep);
			const grad = ctx.createLinearGradient(0, 0, r, 0);
			grad.addColorStop(0, withAlpha(accent, 0));
			grad.addColorStop(1, withAlpha(accent, 0.45));
			ctx.fillStyle = grad;
			ctx.beginPath();
			ctx.moveTo(0, 0);
			ctx.arc(0, 0, r, -0.4, 0.4);
			ctx.closePath();
			ctx.fill();
			ctx.restore();

			ctx.beginPath();
			ctx.arc(cx, cy, 2, 0, Math.PI * 2);
			ctx.fillStyle = accent;
			ctx.fill();

			sweep += 0.04;
			frameId = requestAnimationFrame(draw);
		};

		frameId = requestAnimationFrame(draw);

		document.addEventListener(
			"astro:before-swap",
			() => cancelAnimationFrame(frameId),
			{ once: true },
		);
	}

	function initContactReveal() {
		const scan = document.querySelector<HTMLElement>(".contact-scan");
		if (scan) {
			scan.animate(
				[{ transform: "translateY(-120%)" }, { transform: "translateY(420%)" }],
				{ duration: 4200, iterations: Infinity, easing: "linear" },
			);
		}
		observeSectionReveal("get-in-touch", ".contact-reveal", {
			threshold: 0.12,
		});
	}

	function initContactForm() {
		const form = document.getElementById(
			"contact-form",
		) as HTMLFormElement | null;
		const submitBtn = document.getElementById(
			"contact-submit",
		) as HTMLButtonElement | null;
		const submitLabel = document.getElementById("contact-submit-label");
		const statusEl = document.getElementById("contact-status");
		const subjectSelect = document.getElementById(
			"contact-subject",
		) as HTMLSelectElement | null;
		const subjectHidden = document.getElementById(
			"contact-mail-subject",
		) as HTMLInputElement | null;
		const replyToHidden = document.getElementById(
			"contact-replyto",
		) as HTMLInputElement | null;
		const emailInput = document.getElementById(
			"contact-email",
		) as HTMLInputElement | null;

		if (!form || !submitBtn || !submitLabel || !statusEl) return;

		const endpoint = form.dataset.endpoint;
		if (!endpoint) return;

		const defaultLabel = submitLabel.textContent ?? "Send Transmission";

		const setStatus = (message: string, kind: "success" | "error" | "info") => {
			statusEl.textContent = message;
			statusEl.classList.remove("hidden", "is-success", "is-error", "is-info");
			if (kind === "success") statusEl.classList.add("is-success");
			else if (kind === "error") statusEl.classList.add("is-error");
			else statusEl.classList.add("is-info");
		};

		const setBusy = (busy: boolean) => {
			submitBtn.disabled = busy;
			submitLabel.textContent = busy ? "Transmitting..." : defaultLabel;
		};

		form.addEventListener("submit", async (event) => {
			event.preventDefault();

			const subject = subjectSelect?.value?.trim() || "New portfolio message";
			if (subjectHidden) {
				subjectHidden.value = `Portfolio — ${subject}`;
			}
			if (replyToHidden && emailInput) {
				replyToHidden.value = emailInput.value.trim();
			}

			setBusy(true);
			setStatus("Sending transmission...", "info");

			try {
				const response = await fetch(endpoint, {
					method: "POST",
					headers: {
						"Content-Type": "application/json",
						Accept: "application/json",
					},
					body: JSON.stringify(Object.fromEntries(new FormData(form))),
				});

				const result = (await response.json().catch(() => null)) as {
					success?: string | boolean;
					message?: string;
				} | null;

				if (!response.ok) {
					throw new Error(
						result?.message || "Transmission failed. Please try again.",
					);
				}

				form.reset();
				setStatus(
					"Transmission received. I'll get back to you soon.",
					"success",
				);
			} catch {
				setStatus(
					"Transmission failed. Please email me directly or try again.",
					"error",
				);
			} finally {
				setBusy(false);
			}
		});
	}

