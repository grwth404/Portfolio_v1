---
import { site, iconUrl } from "../data/site";
import { contactLinks } from "../data/contact";
import Icon from "./ui/Icon.astro";

const { nav, name, year, tagline } = site;
---

<footer id="footer" class="mt-24 mb-12 border-t border-text/10 pt-10">
	<div class="grid grid-cols-1 md:grid-cols-3 gap-10">
		<div>
			<a href="#about" class="nav-anchor inline-flex items-center gap-2 group">
				<span class="font-sans font-medium text-sm tracking-tighter text-text">
					{name.split(" ")[0].toUpperCase()}
					<span class="text-accent ml-1">
						{name.split(" ")[1]?.[0] ?? "W"}
					</span>
				</span>
			</a>
			<p
				class="mt-3 font-mono-custom text-[0.6rem] uppercase tracking-wider text-text/60 leading-relaxed max-w-xs"
			>
				{tagline}
			</p>
			<p
				class="mt-4 font-mono-custom text-[0.55rem] uppercase tracking-widest text-text/50"
			>
				© {year}
				{name}
			</p>
		</div>

		<div>
			<p
				class="font-mono-custom text-[0.55rem] uppercase tracking-[0.25em] text-accent mb-4"
			>
				// Navigate
			</p>
			<ul class="grid grid-cols-2 gap-x-4 gap-y-2">
				{
					nav.map((link) => (
						<li>
							<a
								href={link.href}
								class="nav-anchor font-mono-custom text-[0.6rem] uppercase tracking-wider text-text/65 hover:text-accent transition-colors duration-300"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>

		<div>
			<p
				class="font-mono-custom text-[0.55rem] uppercase tracking-[0.25em] text-accent mb-4"
			>
				// Connect
			</p>
			<ul class="space-y-2.5">
				{
					contactLinks.map((item) => (
						<li>
							<a
								href={item.href}
								target={item.external ? "_blank" : undefined}
								rel={item.external ? "noopener noreferrer" : undefined}
								class="nav-anchor group flex items-center gap-2.5 font-mono-custom text-[0.6rem] uppercase tracking-wider text-text/65 hover:text-text transition-colors duration-300"
							>
								<Icon
									icon={item.icon}
									class="h-4 w-4 opacity-70 group-hover:opacity-100 transition-opacity"
								/>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<div
		class="mt-10 pt-5 border-t border-text/10 flex flex-col sm:flex-row items-center justify-between gap-3"
	>
		<span
			class="font-mono-custom text-[0.5rem] uppercase tracking-widest text-text/45"
		>
			Built with Astro · Tailwind CSS
		</span>
		<a
			href="#about"
			class="nav-anchor font-mono-custom text-[0.55rem] uppercase tracking-widest text-text/55 hover:text-accent transition-colors duration-300"
		>
			Back to top ↑
		</a>
	</div>
</footer>
